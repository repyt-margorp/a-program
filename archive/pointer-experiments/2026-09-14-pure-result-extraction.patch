+		const struct pg_evidence *origin = job->left->result, *left, *right, *body = NULL;
+		const struct pg_effect_row *effects;
+		const struct pg_term *type;
+		enum pg_totality totality;
+		enum pg_evidence_rule rule;
+		if (pg_computation_type_view(pg_evidence_classifier(origin), &totality, &effects, &type) &&
+			totality == PG_TOTALITY_TOTAL && !pg_effect_count(effects) &&
+			!pg_prove_computation_view(synthesis->typing, synthesis->classifiers, origin, &rule, &left, &right)) {
+			switch (rule) {
+			case PG_FOLD_ELIM: {
+				struct pg_synthesis_job *argument = pg_synthesis_return(synthesis, job->inputs[0], left);
+				job->value_job = pg_synthesis_application(synthesis, job->inputs[0], pg_synthesis_evidence(synthesis, right), argument);
+				if (!job->value_job) { finish(synthesis, job, PG_SYNTHESIS_ERROR); return; }
+				job->stage = 2;
+				depend(synthesis, job, job->value_job);
+				return;
+			}
+			case PG_APP_ELIM: {
+				body = pg_prove_application_body(synthesis->typing, left, right);
+				const struct pg_evidence *function, *unused;
+				enum pg_evidence_rule function_rule;
+				if (!body && !pg_prove_computation_view(synthesis->typing, synthesis->classifiers,
+					left, &function_rule, &function, &unused)) {
+					switch (function_rule) {
+					case PG_MATCH_ELIM: case PG_INDUCTION_ELIM:
+						function = pg_prove_elimination_body(synthesis->typing, synthesis->classifiers, function); break;
+					case PG_FOLD_ELIM:
+						function = pg_prove_application_body(synthesis->typing, unused,
+							pg_prove_return_origin(synthesis->typing, function)); break;
+					default: function = NULL; break;
+					}
+					if (function) body = pg_prove_application(synthesis->typing, function, right);
+				}
+				break;
