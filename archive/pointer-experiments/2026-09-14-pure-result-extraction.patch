+			case PG_MATCH_ELIM: case PG_INDUCTION_ELIM:
+				body = pg_prove_elimination_body(synthesis->typing, synthesis->classifiers, left); break;
+			case PG_FORCE_ELIM: body = pg_prove_thunk_computation(synthesis->typing, left); break;
+			default: break;
+			}
+			if (body) {
+				job->right = pg_synthesis_return(synthesis, job->inputs[0], body);
+				job->stage = 3;
+				forward_proof(synthesis, job, job->right);
+				return;
