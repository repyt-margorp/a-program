+static int constructor_callable_prepare(struct pg_synthesis *synthesis, struct pg_synthesis_job *job)
+{
+	struct constructor_value_work *local = pg_synthesis_work_state(job, CONSTRUCTOR_VALUE_JOB);
+	if (local->callable) return 0;
+	const struct pg_evidence *formation = pg_synthesis_input_result(pg_synthesis_work_dependency(job, 0));
+	const struct source_constructor *source = pg_synthesis_constructor_source(synthesis, formation, job->inputs[2]);
+	if (!source || !source->implicit_count) return 0;
+	if (source->implicit_count > (SIZE_MAX - sizeof(struct constructor_callable)) / sizeof(size_t)) return -1;
+	struct constructor_callable *callable = pg_alloc(synthesis->typing->graph,
+		sizeof(*callable) + source->implicit_count * sizeof(*callable->indices));
+	if (!callable) return -1;
+	*callable = (struct constructor_callable){.source = source,
+		.field = source->implicit_count, .count = source->implicit_count};
+	for (size_t i = 0; i < callable->count; ++i) callable->indices[i] = i;
+	local->callable = callable;
+	return 0;
+}
