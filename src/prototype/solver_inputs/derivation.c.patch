+	const struct handler_inputs *inputs = owner;
+	return (struct pg_handler_clause){pg_operation_declaration_at(inputs->typing,
+		pg_handler_signature_label(inputs->signature, i),
+		inputs->premise(inputs->owner, 3 + 3 * i), inputs->premise(inputs->owner, 4 + 3 * i)),
+		inputs->premise(inputs->owner, 5 + 3 * i)};
+}
