+static struct pg_synthesis_job *rule_dependency(const struct rule_closure *closure,
+	const struct pg_synthesis_job *job, size_t i)
+{
+	struct pg_synthesis_input input = pg_synthesis_work_dependency(job, 3 + 2 * i);
+	if (!input.checked) return input.pending;
+	const struct pg_dag_node *node = pg_dag_find(&closure->checked, input.checked);
+	return node ? closure->checked_jobs[node->id - 1] : NULL;
+}
