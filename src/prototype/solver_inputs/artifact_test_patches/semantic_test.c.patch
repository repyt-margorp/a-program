+static void reject_copied_revalidation_target(struct pg_program *program, struct pg_synthesis_job *target)
+{
+	const struct pg_synthesis_work_class *role = pg_synthesis_work_role(target);
+	const char *state = pg_synthesis_work_state(target, role);
+	size_t offset = state ? (const char *)target - state : 0;
+	size_t bytes = offset + sizeof(*target) + target->input_count * sizeof(*target->inputs);
+	char *storage = malloc(bytes);
+	assert(storage);
+	memcpy(storage, state ? state : (const char *)target, bytes);
+	struct pg_synthesis_job *copy = (void *)(storage + offset);
+	struct pg_synthesis *synthesis = &program->synthesis;
+	struct pg_synthesis_job *ready = synthesis->ready, *tail = synthesis->ready_tail;
+	size_t jobs = synthesis->jobs.count, proofs = program->typing.proofs.count;
+	uint64_t steps = synthesis->steps, spent = 91;
+	assert(pg_synthesis_input_owned(synthesis, (struct pg_synthesis_input){.pending = pg_synthesis_pending(target)}));
+	assert(!pg_synthesis_input_owned(synthesis, (struct pg_synthesis_input){.pending = pg_synthesis_pending(copy)}));
+	assert(pg_artifact_revalidate(program, copy, 0, 0, &spent) == PG_SYNTHESIS_ERROR);
+	assert(pg_artifact_revalidate(program, copy, 100, 100, &spent) == PG_SYNTHESIS_ERROR);
+	assert(spent == 91 && synthesis->steps == steps);
+	assert(synthesis->ready == ready && synthesis->ready_tail == tail);
+	assert(synthesis->jobs.count == jobs && program->typing.proofs.count == proofs);
+	free(storage);
 }
 
