+static void source_copied_owner(unsigned boundary, int complete)
+{
+	struct pg_program *p = start("main := #1;");
+	struct pg_synthesis *s = &p->synthesis;
+	advance(s, complete ? 10000 : 1);
+	assert(p->root->status == (complete ? PG_SYNTHESIS_DONE : PG_SYNTHESIS_PENDING));
+	struct checkpoint c = collect(p);
+	assert(c.jobs[0] == p->root && c.sources[0] == p->root);
+	const struct pg_synthesis_work_class *role = pg_synthesis_work_role(p->root);
+	const char *state = pg_synthesis_work_state(p->root, role);
+	size_t offset = state ? (const char *)p->root - state : 0;
+	size_t bytes = offset + sizeof(*p->root) + p->root->input_count * sizeof(*p->root->inputs);
+	char *storage = malloc(bytes);
+	assert(storage);
+	memcpy(storage, state ? state : (const char *)p->root, bytes);
+	struct pg_synthesis_job *copy = (void *)(storage + offset);
+	assert(pg_synthesis_input_owned(s, (struct pg_synthesis_input){.pending = pg_synthesis_pending(p->root)}));
+	assert(!pg_synthesis_input_owned(s, (struct pg_synthesis_input){.pending = pg_synthesis_pending(copy)}));
+	unsigned char original[sizeof(*p->root)];
+	memcpy(original, p->root, sizeof(original));
+	struct pg_synthesis_job *ready = s->ready, *tail = s->ready_tail;
+	size_t jobs = s->jobs.count, proofs = p->typing.proofs.count;
+	uint64_t steps = s->steps;
+	c.jobs[0] = c.sources[0] = copy;
+	if (!boundary)
+		assert(!pg_artifact_source_capture(&p->graph, s, c.count, c.jobs, c.source_count, c.sources));
+	else if (boundary == 1)
+		assert(pg_artifact_source_prepare(s, c.source, c.count, c.jobs));
+	else assert(pg_artifact_source_attach(s, c.source, c.count, c.jobs));
+	assert(s->steps == steps && s->ready == ready && s->ready_tail == tail);
+	assert(s->jobs.count == jobs && p->typing.proofs.count == proofs);
+	assert(!memcmp(original, p->root, sizeof(original)));
+	c.jobs[0] = c.sources[0] = p->root;
+	free(storage);
+	assert(pg_artifact_source_capture(&p->graph, s, c.count, c.jobs, c.source_count, c.sources));
+	if (!complete) assert(!pg_artifact_source_prepare(s, c.source, c.count, c.jobs));
+	else assert(pg_artifact_source_prepare(s, c.source, c.count, c.jobs));
+	assert(!pg_artifact_source_attach(s, c.source, c.count, c.jobs));
+	assert(s->steps == steps && p->typing.proofs.count == proofs);
+	pg_program_destroy(p);
+}
