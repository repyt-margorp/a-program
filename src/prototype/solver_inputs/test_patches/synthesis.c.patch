+	struct pg_synthesis_job *adapter = pg_synthesis_evidence(&synthesis, empty);
+	struct pg_synthesis_input legacy = pending_input(adapter);
+	size_t jobs = synthesis.jobs.count;
+	assert(call == pg_synthesis_application(&synthesis, legacy, function, argument));
+	assert(sequence == pg_synthesis_sequence(&synthesis, legacy, returned, function));
+	assert(extended == pg_synthesis_result_context(&synthesis, legacy, returned, result));
+	assert(carrier == pg_synthesis_constant_result(&synthesis, legacy, function, 1));
+	assert(clause == pg_synthesis_handler_context(&synthesis, legacy, carrier, pending_input(type), pending_input(type), payload, resume, response));
+	struct pg_synthesis_job *checked_clause = pg_synthesis_handler_context(&synthesis, c, carrier,
+		checked_input(domain), checked_input(domain), payload, resume, response);
+	assert(checked_clause);
+	const struct pg_evidence *checked_context = complete(&synthesis, checked_clause, PG_SYNTHESIS_DONE);
+	assert(pg_evidence_judgement(checked_context) == PG_JUDGEMENT_CONTEXT);
