+	for (size_t i = 0; i < 5; ++i) complete(&synthesis, requests[i], PG_SYNTHESIS_DONE);
+	same_judgement(normalize(&synthesis, empty, pg_synthesis_result(call)),
+		normalize(&synthesis, empty, pg_synthesis_result(sequence)));
