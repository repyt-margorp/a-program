+static void direct_context_consumers(struct pg_typing *typing)
+{
+	struct pg_whnf_work work;
+	struct pg_synthesis synthesis, foreign;
+	assert(!pg_whnf_work_init(&work, typing->graph));
+	assert(!pg_synthesis_init(&synthesis, typing, &work, PG_DEFINITION_EXPLICIT_THUNK));
+	assert(!pg_synthesis_init(&foreign, typing, &work, PG_DEFINITION_EXPLICIT_THUNK));
+	const struct pg_evidence *empty = pg_prove_empty_context(typing);
+	const struct pg_object *x = pg_binder(typing->graph), *result = pg_binder(typing->graph);
+	const struct pg_object *payload = pg_binder(typing->graph), *resume = pg_binder(typing->graph);
+	const struct pg_object *response = pg_binder(typing->graph);
+	const struct pg_evidence *domain = pg_prove_universe(typing, empty, 1);
+	const struct pg_evidence *inner = pg_prove_context_extension(typing, empty, x, domain);
+	struct pg_synthesis_input c = checked_input(empty), v = checked_input(pg_prove_variable(typing, inner, x));
+	struct pg_synthesis_job *variable = pg_synthesis_plain_rule_inputs(&synthesis, PG_CONTEXT_PROJECTION, NULL, 2,
+		(struct pg_synthesis_input[]){checked_input(inner), v});
+	struct pg_synthesis_job *function = pg_synthesis_lambda_body(&synthesis, checked_input(inner), (struct pg_synthesis_input){.pending = variable});
+	struct pg_synthesis_job *argument = pg_synthesis_plain_rule_inputs(&synthesis, PG_VALUE_FROM_TYPE, NULL, 1,
+		&(struct pg_synthesis_input){.checked = pg_prove_universe(typing, empty, 0)});
+	struct pg_synthesis_job *returned = pg_synthesis_body(&synthesis, (struct pg_synthesis_input){.pending = argument}, c);
+	struct pg_synthesis_job *type = pg_synthesis_plain_rule_inputs(&synthesis, PG_CONTEXT_PROJECTION, NULL, 2,
+		(struct pg_synthesis_input[]){c, checked_input(domain)});
+	struct pg_synthesis_job *call = pg_synthesis_application(&synthesis, c, function, argument);
+	struct pg_synthesis_job *sequence = pg_synthesis_sequence(&synthesis, c, returned, function);
+	struct pg_synthesis_job *extended = pg_synthesis_result_context(&synthesis, c, returned, result);
+	struct pg_synthesis_job *carrier = pg_synthesis_constant_result(&synthesis, c, function, 1);
+	struct pg_synthesis_job *clause = pg_synthesis_handler_context(&synthesis, c, carrier, pending_input(type), pending_input(type), payload, resume, response);
+	struct pg_synthesis_job *requests[] = {call, sequence, extended, carrier, clause};
+	pg_synthesis_advance(&synthesis, 0);
+	assert(!synthesis.steps);
+	for (size_t i = 0; i < 5; ++i) assert(requests[i] && !pg_synthesis_result(requests[i]));
+	for (size_t i = 0; i < 5; ++i) complete(&synthesis, requests[i], PG_SYNTHESIS_DONE);
+	same_judgement(normalize(&synthesis, empty, pg_synthesis_result(call)),
+		normalize(&synthesis, empty, pg_synthesis_result(sequence)));
+	for (size_t i = 0; i < synthesis.jobs.capacity; ++i)
+		for (struct pg_index_entry *entry = synthesis.jobs.buckets[i]; entry; entry = entry->next)
+			assert(!pg_synthesis_evidence_input((const void *)entry));
+
+	struct pg_synthesis_job *adapter = pg_synthesis_evidence(&synthesis, empty);
+	struct pg_synthesis_input legacy = pending_input(adapter);
+	size_t jobs = synthesis.jobs.count;
+	assert(call == pg_synthesis_application(&synthesis, legacy, function, argument));
+	assert(sequence == pg_synthesis_sequence(&synthesis, legacy, returned, function));
+	assert(extended == pg_synthesis_result_context(&synthesis, legacy, returned, result));
+	assert(carrier == pg_synthesis_constant_result(&synthesis, legacy, function, 1));
+	assert(clause == pg_synthesis_handler_context(&synthesis, legacy, carrier, pending_input(type), pending_input(type), payload, resume, response));
+	struct pg_synthesis_job *checked_clause = pg_synthesis_handler_context(&synthesis, c, carrier,
+		checked_input(domain), checked_input(domain), payload, resume, response);
+	assert(checked_clause);
+	const struct pg_evidence *checked_context = complete(&synthesis, checked_clause, PG_SYNTHESIS_DONE);
+	assert(pg_evidence_judgement(checked_context) == PG_JUDGEMENT_CONTEXT);
+	assert(pg_evidence_context(checked_context) == pg_evidence_context(pg_synthesis_result(clause)));
+	jobs = synthesis.jobs.count;
+	assert(synthesis.jobs.count == jobs);
+	struct pg_synthesis_job *other = pg_synthesis_plain_rule(&foreign, PG_CONTEXT_EMPTY, NULL, 0, NULL);
+	struct pg_synthesis_input invalid[] = {{0}, {empty, adapter}, {.pending = other}};
+	for (size_t i = 0; i < 3; ++i) {
+		assert(!pg_synthesis_application(&synthesis, invalid[i], function, argument));
+		assert(!pg_synthesis_sequence(&synthesis, invalid[i], returned, function));
+		assert(!pg_synthesis_result_context(&synthesis, invalid[i], returned, result));
+		assert(!pg_synthesis_constant_result(&synthesis, invalid[i], function, 1));
+		assert(!pg_synthesis_handler_context(&synthesis, invalid[i], carrier, pending_input(type), pending_input(type), payload, resume, response));
+		assert(!pg_synthesis_handler_context(&synthesis, c, carrier, invalid[i], checked_input(domain), payload, resume, response));
+		assert(!pg_synthesis_handler_context(&synthesis, c, carrier, checked_input(domain), invalid[i], payload, resume, response));
+	}
+	assert(synthesis.jobs.count == jobs);
+	struct pg_synthesis_input pending = pending_input(pg_synthesis_plain_rule(&synthesis, PG_CONTEXT_EMPTY, NULL, 0, NULL));
+	struct pg_synthesis_job *open = pg_synthesis_sequence(&synthesis, pending, returned, function);
+	assert(open && open != sequence);
+	same_judgement(complete(&synthesis, open, PG_SYNTHESIS_DONE), pg_synthesis_result(sequence));
+	assert(open == pg_synthesis_sequence(&synthesis, pending, returned, function));
+	assert(pg_synthesis_work_dependency(open, 0).pending == pending.pending);
+	pg_synthesis_destroy(&foreign);
+	pg_synthesis_destroy(&synthesis);
+	pg_whnf_work_destroy(&work);
+}
