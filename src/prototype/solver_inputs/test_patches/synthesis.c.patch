+	struct pg_synthesis_job *function = pg_synthesis_lambda_body(&synthesis, checked_input(inner), variable);
+	struct pg_synthesis_job *argument = pg_synthesis_plain_rule_inputs(&synthesis, PG_VALUE_FROM_TYPE, NULL, 1,
+		&(struct pg_synthesis_input){.checked = pg_prove_universe(typing, empty, 0)});
+	struct pg_synthesis_job *returned = pg_synthesis_body(&synthesis, argument, c);
+	struct pg_synthesis_job *type = pg_synthesis_plain_rule_inputs(&synthesis, PG_CONTEXT_PROJECTION, NULL, 2,
+		(struct pg_synthesis_input[]){c, checked_input(domain)});
+	struct pg_synthesis_job *call = pg_synthesis_application(&synthesis, c, function, argument);
+	struct pg_synthesis_job *sequence = pg_synthesis_sequence(&synthesis, c, returned, function);
+	struct pg_synthesis_job *extended = pg_synthesis_result_context(&synthesis, c, returned, result);
+	struct pg_synthesis_job *carrier = pg_synthesis_constant_result(&synthesis, c, function, 1);
+	struct pg_synthesis_job *clause = pg_synthesis_handler_context(&synthesis, c, carrier, pending_input(type), pending_input(type), payload, resume, response);
+	struct pg_synthesis_job *requests[] = {call, sequence, extended, carrier, clause};
+	pg_synthesis_advance(&synthesis, 0);
