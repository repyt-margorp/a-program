+			assert(consumer->dependency->child == pg_pending_job(pg_synthesis_work_output(body).pending));
+			assert(!consumer->result);
+			assert(pg_evidence_rule(complete(&synthesis, consumer, PG_SYNTHESIS_DONE)) == PG_THUNK_INTRO);
+		}
+		assert(complete(&synthesis, body, PG_SYNTHESIS_DONE) == computation);
+		assert(!body->result);
+		assert(pg_synthesis_input_result(pg_synthesis_work_output(body)) == computation);
+		assert(pg_synthesis_body(&synthesis, checked_input(inputs[i]), checked_input(empty)) == body);
+		complete(&synthesis, pg_synthesis_body(&synthesis, checked_input(inputs[i]), checked_input(context)), PG_SYNTHESIS_REJECTED);
+	}
+	/* No checked leaf becomes a completed scheduler node. */
+	size_t jobs = synthesis.jobs.count;
+	assert(!pg_synthesis_body(&synthesis, (struct pg_synthesis_input){type, pg_synthesis_pending(producer)}, checked_input(empty)));
+	assert(!pg_synthesis_body(&synthesis, pending_input(foreign), checked_input(empty)));
+	assert(!pg_synthesis_body(&synthesis, checked_input(type), pending_input(foreign)));
+	assert(synthesis.jobs.count == jobs);
+	complete(&synthesis, pg_synthesis_body(&synthesis, checked_input(value), checked_input(type)), PG_SYNTHESIS_REJECTED);
+	complete(&synthesis, pg_synthesis_body(&synthesis, checked_input(empty), checked_input(empty)), PG_SYNTHESIS_REJECTED);
+	struct pg_synthesis_job *invalid = request(&synthesis, pg_synthesis_root(&synthesis), "v:=&(@); ");
+	struct pg_synthesis_job *unchecked_body = pg_synthesis_body(&synthesis, pending_input(invalid), (struct pg_synthesis_input){0});
+	for (unsigned n = 0; unchecked_body->status == PG_SYNTHESIS_PENDING; ++n) {
+		assert(n < 100);
+		pg_synthesis_advance(&synthesis, 1);
+	}
+	assert(unchecked_body->status == PG_SYNTHESIS_DONE && !unchecked_body->result);
+	complete(&synthesis, unchecked_body, PG_SYNTHESIS_REJECTED);
+	assert(!pg_synthesis_result(unchecked_body));
+	const struct pg_evidence *variable = pg_prove_variable(typing, context, binder);
+	const struct pg_evidence *inner_type = pg_prove_universe(typing, context, 0);
+	struct pg_synthesis_job *inner = pg_synthesis_body(&synthesis, checked_input(inner_type), checked_input(context));
+	const struct pg_evidence *inner_result = complete(&synthesis, inner, PG_SYNTHESIS_DONE);
+	assert(pg_evidence_subject(inner_result)->core == pg_evidence_subject(computation)->core);
+	assert(inner != pg_synthesis_body(&synthesis, checked_input(type), checked_input(empty)));
+	assert(pg_evidence_context(inner_result) != pg_evidence_context(computation));
+	struct pg_synthesis_job *lambda = pg_synthesis_abstract(&synthesis, empty, context, checked_input(variable));
+	assert(lambda && pg_synthesis_abstract(&synthesis, empty, context, checked_input(variable)) == lambda);
+	const struct pg_evidence *abstracted = complete(&synthesis, lambda, PG_SYNTHESIS_DONE);
+	const struct pg_term *returned = pg_application(typing->graph,
+		pg_reference(typing->graph, &pg_return_operation), pg_evidence_subject(variable)->core);
+	assert(pg_evidence_subject(abstracted)->core == pg_lambda(typing->graph, binder, returned));
+	assert(!pg_synthesis_abstract(&synthesis, context, empty, checked_input(variable)));
+	struct pg_graph graph;
+	struct pg_typing typing_other;
+	assert(!pg_graph_init(&graph) && !pg_typing_init(&typing_other, &graph));
+	const struct pg_evidence *wrong = pg_prove_universe(&typing_other, pg_prove_empty_context(&typing_other), 0);
+	jobs = synthesis.jobs.count;
+	assert(!pg_synthesis_body(&synthesis, checked_input(wrong), checked_input(empty)));
+	assert(synthesis.jobs.count == jobs);
+	pg_typing_destroy(&typing_other); pg_graph_destroy(&graph);
+	pg_synthesis_destroy(&other); pg_synthesis_destroy(&synthesis); pg_whnf_work_destroy(&work);
+	puts("direct bodies: no input adapters, exact typed sharing, ordinary lifting, context guards and abstraction passed");
+}
