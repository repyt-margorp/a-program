+// Test-only legacy policy: keep every original eager-demand assertion while
+// the independent performance head test checks the selected lazy policy.
+static int materialized_force_dispatch(struct pg_eval *machine)
+{
+	if (machine->current.term->kind == PG_REFERENCE
+		&& machine->current.term->as.reference == &pg_force_operation
+		&& pg_eval_argument(machine, 0))
+		return pg_eval_demand(machine, 0,
+			pg_computation_continuation_resolve("computation/force_answer/v1"), NULL);
+	return pg_pure_policy.dispatch(machine);
+}
+
+static void materialized_force_init(struct pg_eval *machine,
+	struct pg_graph *graph, const struct pg_term *term)
+{
+	pg_computation_eval_init(machine, graph, term);
+	machine->dispatch = materialized_force_dispatch;
+}
