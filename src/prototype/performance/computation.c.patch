+static const struct pg_closure *head_unary(struct pg_closure head,
+	const struct pg_argument *arguments, const struct pg_object *operation)
+{
+	return head.term->kind == PG_REFERENCE && head.term->as.reference == operation
+		&& arguments && !arguments->next ? &arguments->value : NULL;
+}
+
+static int force_head(struct pg_eval *machine, struct pg_closure head,
+	const struct pg_argument *arguments, const void *state)
+{
+	(void)state;
+	const struct pg_closure *body = head_unary(head, arguments, &pg_thunk_operation);
+	return body ? pg_eval_enter(machine, *body, 1) : 2;
+}
+
+static int fold_head(struct pg_eval *machine, struct pg_closure head,
+	const struct pg_argument *arguments, const void *state)
+{
+	(void)state;
+	const struct pg_closure *value = head_unary(head, arguments, &pg_return_operation);
+	if (!value) return 2;
+	const struct handler_entry *handler = handler_owner(machine->current.term->as.reference);
+	return pg_eval_apply(machine, *pg_eval_argument(machine, 1), *value,
+		(handler ? handler->count : 0) + 2);
+}
+
+static int total_result_head(struct pg_eval *machine, struct pg_closure head,
+	const struct pg_argument *arguments, const void *state)
+{
+	(void)state;
+	const struct pg_closure *value = head_unary(head, arguments, &pg_return_operation);
+	return value ? pg_eval_enter(machine, *value, 1) : 2;
+}
+
+static const struct pg_eval_head_continuation force_head_continuation = {
+	{"computation/force_head/v1", pg_eval_head_marker}, force_head, &force_answer_continuation
+};
+static const struct pg_eval_head_continuation fold_head_continuation = {
