+static struct pg_synthesis_job *prepared_premise(const struct pg_synthesis *synthesis,
+	const struct pg_synthesis_job *job, size_t index)
+{
+	const struct pg_derivation_input *input = job->inputs[0];
+	const void *key[] = {input->premises[index], job->inputs[1]};
+	struct pg_synthesis_job *premise = pg_synthesis_work_find(synthesis, DERIVATION_INPUT_JOB, 2, key);
+	return pg_synthesis_work_project(premise).rule;
+}
+
+static struct pg_synthesis_job *prepared_rule(struct pg_synthesis *synthesis,
+	const struct pg_synthesis_job *job, enum pg_synthesis_status *failure)
+{
+	const struct pg_derivation_input *input = job->inputs[0];
+	struct pg_effect_inference *work = (void *)job->inputs[1];
+	*failure = PG_SYNTHESIS_REJECTED;
+	if (input->count > SIZE_MAX / sizeof(struct pg_synthesis_job *)) {
+		*failure = PG_SYNTHESIS_ERROR; return NULL;
+	}
+	struct pg_derivation_input header = *input;
+	struct pg_effect_equation *equation = NULL;
+	if (input->effect_parameter) {
+		equation = pg_effect_equation_find(work, input->effect_parameter);
+		if (!equation) return NULL;
+		header.effect_parameter = NULL;
+	}
+	struct pg_synthesis_job **premises = input->count ? malloc(input->count * sizeof(*premises)) : NULL;
+	if (input->count && !premises) { *failure = PG_SYNTHESIS_ERROR; return NULL; }
+	for (size_t i = 0; i < input->count; ++i) premises[i] = prepared_premise(synthesis, job, i);
+	struct pg_synthesis_job *rule = pg_synthesis_rule(synthesis, &header, premises, equation ? work : NULL, equation);
+	free(premises);
+	return rule;
+}
+
+int pg_synthesis_derivation_resume(struct pg_synthesis *synthesis,
+	struct pg_synthesis_job *job, size_t next, int prepared)
+{
+	size_t previous;
+	struct pg_synthesis_job *rule;
+	if (pg_synthesis_derivation_frontier(synthesis, job, &previous, &rule) || previous || rule) return -1;
+	if (job->status != PG_SYNTHESIS_PENDING || (prepared != 0 && prepared != 1)) return -1;
+	const struct pg_derivation_input *input = job->inputs[0];
+	if (next > input->count || (prepared && next != input->count)) return -1;
+	for (size_t i = 0; i < next; ++i) if (!prepared_premise(synthesis, job, i)) return -1;
+	if (prepared) {
+		enum pg_synthesis_status failure;
+		rule = prepared_rule(synthesis, job, &failure);
+		if (!rule) return -1;
+	}
+	struct derivation_input_work *local = pg_synthesis_work_state(job, DERIVATION_INPUT_JOB);
+	local->next = next;
+	local->rule = rule;
+	return 0;
+}
