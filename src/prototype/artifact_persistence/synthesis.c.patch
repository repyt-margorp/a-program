+int pg_synthesis_definition_frontier(const struct pg_synthesis *synthesis,
+	const struct pg_synthesis_job *registration, struct pg_definition_frontier *view)
+{
+	if (!synthesis || !registration || !view || registration->owner != synthesis->owner_key
+		|| registration->role != DEFINITION_SCOPE_JOB) return -1;
+	if (registration->status != PG_SYNTHESIS_PENDING && registration->status != PG_SYNTHESIS_DONE) return -1;
+	const struct definition_state *state = source_work(registration)->definitions;
+	if (!state) return -1;
+	*view = (struct pg_definition_frontier){.count = state->count, .indexed = state->indexed,
+		.activated = state->activated, .entries = state->entries, .complete = registration->status == PG_SYNTHESIS_DONE};
+	return 0;
+}
