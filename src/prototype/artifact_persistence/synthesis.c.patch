+	const struct source_work *local = source_work(job);
+	if (job->status != PG_SYNTHESIS_PENDING || local->value_job || local->callable) return 0;
+	if (!local->left || local->left->status != PG_SYNTHESIS_DONE) return 0;
+	*scope = local->left->result;
+	return 1;
