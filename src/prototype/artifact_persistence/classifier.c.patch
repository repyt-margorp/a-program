+static size_t effect_position(const struct pg_effect_row *row, const struct pg_object *label)
+{
+	size_t low = 0, high = row->count;
+	while (low < high) {
+		size_t middle = low + (high - low) / 2;
+		if ((uintptr_t)row->labels[middle] < (uintptr_t)label) low = middle + 1;
+		else high = middle;
+	}
+	return low;
+}
+
+struct effect_order {
+	size_t count;
+	const struct pg_object *const *labels;
+};
+
+/* Membership uses sorted pointers. Enumeration retains the first construction
+ * order, so relocating those pointers cannot reorder the semantic payload. */
+static int order_effects(struct pg_graph *graph, struct pg_effect_row *row,
+	size_t count, const struct effect_order *inputs)
+{
+	row->order = pg_alloc(graph, row->count * sizeof(*row->order));
+	if (!row->order) return -1;
+	unsigned char *seen = calloc(row->count, 1);
+	if (!seen) return -1;
+	size_t next = 0;
+	for (size_t i = 0; i < count; ++i)
+		for (size_t j = 0; j < inputs[i].count; ++j) {
+			const struct pg_object *label = inputs[i].labels[j];
+			size_t index = effect_position(row, label);
+			if (index == row->count || row->labels[index] != label) continue;
+			if (seen[index]) continue;
+			seen[index] = 1;
+			row->order[next++] = label;
+		}
+	free(seen);
+	return next == row->count ? 0 : -1;
+}
